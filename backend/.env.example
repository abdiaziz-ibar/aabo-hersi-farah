# Copy this file to .env and paste your Neon connection string.
# Neon dashboard -> your project -> Connect -> copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
PORT=4000
# Frontend URL(s) allowed to call this API (comma-separated). Leave empty to allow all.
CORS_ORIGIN=http://localhost:5173
# REQUIRED: secret used to sign login tokens (min 32 chars, the server refuses to start otherwise). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional hardening
# TRUST_PROXY=1            # set when behind a reverse proxy so real client IPs are used
# DB_SSL_INSECURE=true     # only for a self-signed database certificate (Neon does not need this)
